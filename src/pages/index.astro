---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="By Ankit — engineering, education, technology, research and useful digital tools."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>By Ankit — A digital home</title>
	</head>

	<body>
		<!-- =========================================================
		     HEADER
		     ========================================================= -->

		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label="By Ankit home">
					<span class="brand-mark">A</span>
					<span class="brand-name">By Ankit</span>
				</a>

				<nav aria-label="Main navigation">
					<a href="#about">About</a>
					<a href="#work">Work</a>
					<a href="#apps">Apps</a>
					<a href="#research">Research</a>
				</nav>
			</div>
		</header>

		<main>

			<!-- =====================================================
			     HERO
			     ===================================================== -->

			<section class="hero container">
				<p class="eyebrow">
					Engineering · Education · Technology · Research
				</p>

				<h1>
					Building things<br />
					<span>worth using.</span>
				</h1>

				<p class="hero-text">
					I'm Ankit Sharma. This is my digital home — a place for
					the things I build, explore, teach, research, and find
					useful.
				</p>

				<div class="hero-actions">
					<a class="button button-primary" href="#work">
						Explore my work
					</a>

					<a class="button button-secondary" href="#apps">
						Explore my apps
					</a>
				</div>
			</section>


			<!-- =====================================================
			     ABOUT
			     ===================================================== -->

			<section id="about" class="section container">
				<div class="section-intro">
					<p class="eyebrow">About</p>

					<h2>
						A little about the person behind the work.
					</h2>

					<p>
						Engineering, education, technology and research have
						different languages, but I enjoy finding the connections
						between them.
					</p>

					<p>
						This space brings those different parts of my work
						together in one place.
					</p>
				</div>
			</section>


			<!-- =====================================================
			     WORK
			     ===================================================== -->

			<section id="work" class="section section-soft">
				<div class="container">

					<div class="section-intro">
						<p class="eyebrow">Work</p>

						<h2>
							Things I create, explore and improve.
						</h2>

						<p>
							A selection of work across engineering, education,
							technology and practical problem-solving.
						</p>
					</div>

					<div class="feature-grid">

						<article class="feature">
							<span class="feature-number">01</span>

							<h3>Engineering</h3>

							<p>
								Design, analysis, calculation and practical
								engineering solutions.
							</p>
						</article>

						<article class="feature">
							<span class="feature-number">02</span>

							<h3>Education</h3>

							<p>
								Teaching, learning and exploring how technology
								can make education more useful.
							</p>
						</article>

						<article class="feature">
							<span class="feature-number">03</span>

							<h3>Technology</h3>

							<p>
								Digital experiments, applications and simple
								ideas that solve interesting problems.
							</p>
						</article>

					</div>
				</div>
			</section>


			<!-- =====================================================
			     APPS
			     ===================================================== -->

			<section id="apps" class="apps-section">
				<div class="section-inner">
					<div class="section-intro">
					<p class="eyebrow">APPS</p>
					<h2>Useful things you can actually use.</h2>
					<p class="section-lead">
						A growing collection of practical tools and applications built to
						solve real problems in engineering, education, and everyday work.
					</p>
					</div>

					<div class="apps-list">
					<a href="apps/IS456-Structural-Design/index.html" class="app-item">
					<div class="app-number">01</div>

					<div class="app-content">
						<p class="app-category">STRUCTURAL ENGINEERING</p>
						<h3>IS 456 Structural Design Suite</h3>
						<p>
						A collection of practical structural design tools based on
						IS 456 for common reinforced concrete design tasks.
						</p>
					</div>

					<div class="app-arrow" aria-hidden="true">↗</div>
					</a>

					<article class="app-item">
						<div class="app-number">02</div>
						<div class="app-content">
						<p class="app-category">CONCRETE TECHNOLOGY</p>
						<h3>Concrete Mix Design</h3>
						<p>
							A practical tool for working through concrete mix design
							calculations and related parameters.
						</p>
						</div>
						<div class="app-arrow" aria-hidden="true">↗</div>
					</article>

					<article class="app-item">
						<div class="app-number">03</div>
						<div class="app-content">
						<p class="app-category">TRANSPORTATION ENGINEERING</p>
						<h3>IRC 37 Flexible Pavement Design</h3>
						<p>
							A focused engineering application for flexible pavement
							design using the relevant IRC methodology.
						</p>
						</div>
						<div class="app-arrow" aria-hidden="true">↗</div>
					</article>

					<article class="app-item">
						<div class="app-number">04</div>
						<div class="app-content">
						<p class="app-category">CONSTRUCTION</p>
						<h3>Site Quantity Estimator</h3>
						<p>
							A practical tool for estimating construction quantities
							and making everyday site calculations easier.
						</p>
						</div>
						<div class="app-arrow" aria-hidden="true">↗</div>
					</article>
					</div>

					<div class="apps-footer">
					<p>
						More calculators, generators, design tools and experiments are
						being added to the collection.
					</p>
					<a href="/apps" class="apps-link">Explore all apps&nbsp; →</a>
					</div>
				</div>
				</section>


			<!-- =====================================================
			     RESEARCH
			     ===================================================== -->

			<section id="research" class="section section-dark">

				<div class="container research-content">

					<div class="section-intro">

						<p class="eyebrow">Research</p>

						<h2>
							Questions worth exploring.
						</h2>

						<p>
							Research, publications, technical investigations
							and ideas developed through curiosity, evidence
							and experimentation.
						</p>

					</div>

					<a class="text-link" href="#research">
						Explore research
						<span aria-hidden="true">→</span>
					</a>

				</div>
			</section>


			<!-- =====================================================
			     CLOSING
			     ===================================================== -->

			<section class="section container">

				<div class="section-intro">

					<p class="eyebrow">Keep exploring</p>

					<h2>
						There is always something more to discover.
					</h2>

					<p>
						Explore the work, try a tool, read the research,
						or simply stay curious.
					</p>

				</div>

			</section>

		</main>


		<!-- =========================================================
		     FOOTER
		     ========================================================= -->

		<footer class="site-footer">
			<div class="container footer-inner">
				<p>© {new Date().getFullYear()} By Ankit</p>

				<p>Built with curiosity.</p>
			</div>
		</footer>

	</body>
</html>