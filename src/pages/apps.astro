---
const apps = [
  {
    number: "01",
    category: "STRUCTURAL ENGINEERING",
    title: "IS 456 Structural Design Suite",
    description:
      "Practical reinforced concrete design tools based on IS 456.",
    href: "/apps/IS456-Structural-Design/index.html",
  },
  {
    number: "02",
    category: "CONCRETE TECHNOLOGY",
    title: "Concrete Mix Design",
    description:
      "A practical tool for concrete mix design calculations.",
    href: "/apps/concrete-mix-design/index.html",
  },
  {
    number: "03",
    category: "TRANSPORTATION ENGINEERING",
    title: "IRC 37 Flexible Pavement Design",
    description:
      "A focused application for flexible pavement design.",
    href: "/apps/irc37-mix-design/index.html",
  },
  {
    number: "04",
    category: "CONSTRUCTION",
    title: "Site Quantity Estimator",
    description:
      "A practical tool for everyday construction quantity estimation.",
    href: "/apps/site-quantity-estimator/index.html",
  },
  {
    number: "05",
    category: "STRUCTURAL ENGINEERING",
    title: "IS 456 Column Design",
    description:
      "Reinforced concrete column design calculations based on IS 456.",
    href: "/apps/IS456-column-design/index.html",
  },
  {
    number: "06",
    category: "STRUCTURAL ENGINEERING",
    title: "IS 456 Staircase Design Suite",
    description:
      "Practical reinforced concrete staircase design and checks.",
    href: "/apps/IS456-staircase-design/index.html",
  },
  {
    number: "07",
    category: "CONCRETE TECHNOLOGY",
    title: "Aggregate Dry Mix Design",
    description:
      "A practical tool for aggregate and dry mix design calculations.",
    href: "/apps/aggregate-dry-mix-design/index.html",
  },
  {
    number: "08",
    category: "CONSTRUCTION",
    title: "Bar Bending Schedule Generator",
    description:
      "A useful tool for preparing and working with bar bending schedules.",
    href: "/apps/bbs-generator/index.html",
  },
  {
    number: "09",
    category: "ENGINEERING TOOLS",
    title: "IS 456 Checker",
    description:
      "A focused tool for checking reinforced concrete design requirements.",
    href: "/apps/IS456-checker/index.html",
  },
  {
    number: "10",
    category: "PUJA",
    title: "Puja Vidhi",
    description:
      "A practical digital resource for accessing puja vidhi information.",
    href: "/apps/puja-vidhi/index.html",
  },
  {
    number: "11",
    category: "EDUCATION",
    title: "Transportation Engineering Lab Manual",
    description:
      "A digital laboratory resource for transportation engineering.",
    href: "/apps/transportation-lab-manual/index.html",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Apps — By Ankit</title>
    <meta
      name="description"
      content="Practical engineering, education and technology applications built by Ankit."
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">A</span>
          <span class="brand-name">By Ankit</span>
        </a>

        <nav aria-label="Main navigation">
          <a href="/#about">About</a>
          <a href="/#work">Work</a>
          <a href="/#apps">Apps</a>
          <a href="/#research">Research</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="apps-hero">
        <div class="container">
          <p class="eyebrow">APPS</p>

          <h1>
            Things built<br />
            to be useful.
          </h1>

          <p class="intro">
            Practical tools, calculators, generators and resources
            built for engineering, education and everyday work.
          </p>
        </div>
      </section>

      <section class="apps-collection">
        <div class="container">
          <div class="collection-header">
            <div>
              <p class="eyebrow">THE COLLECTION</p>
            </div>

            <p>11 applications</p>
          </div>

          <div class="apps-grid">
            {
              apps.map((app) => (
                <a href={app.href} class="app-card">
                  <div class="app-card-top">
                    <span class="app-number">{app.number}</span>
                    <span class="app-arrow" aria-hidden="true">↗</span>
                  </div>

                  <div class="app-card-content">
                    <p class="app-category">{app.category}</p>

                    <h2>{app.title}</h2>

                    <p class="app-description">
                      {app.description}
                    </p>
                  </div>

                  <span class="open-app">Open app</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} By Ankit</span>
        <span>Built with curiosity.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f5f0;
    color: #18211d;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(calc(100% - 3rem), 1180px);
    margin-inline: auto;
  }

  /* =========================
     Header
     ========================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 245, 240, 0.94);
    border-bottom: 1px solid #dce3de;
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 9px;
    background: #155e4a;
    color: #fff;
    font-size: 0.88rem;
  }

  .brand-name {
    font-size: 1.05rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  nav a {
    color: #52605a;
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: #155e4a;
  }

  /* =========================
     Hero
     ========================= */

  .apps-hero {
    padding: 8rem 0 7rem;
    border-bottom: 1px solid #dce3de;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #155e4a;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(4rem, 8vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
    font-weight: 700;
  }

  .intro {
    max-width: 650px;
    margin: 2.5rem 0 0;
    color: #52605a;
    font-size: 1.12rem;
    line-height: 1.75;
  }

  /* =========================
     Collection
     ========================= */

  .apps-collection {
    padding: 4rem 0 8rem;
  }

  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #c7d2cb;
  }

  .collection-header .eyebrow {
    margin: 0;
  }

  .collection-header p:last-child {
    margin: 0;
    color: #74807a;
    font-size: 0.9rem;
  }

  /* =========================
     App Grid
     ========================= */

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding-top: 1.25rem;
  }

  .app-card {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid #dce3de;
    border-radius: 12px;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .app-card:hover {
    transform: translateY(-4px);
    border-color: #b7c9c0;
    box-shadow: 0 12px 30px rgba(24, 33, 29, 0.07);
  }

  .app-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .app-number {
    color: #74807a;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .app-arrow {
    color: #155e4a;
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .app-card:hover .app-arrow {
    transform: translate(3px, -3px);
  }

  .app-card-content {
    flex: 1;
    padding-top: 3.5rem;
  }

  .app-category {
    margin: 0 0 0.7rem;
    color: #155e4a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.4;
  }

  .app-card h2 {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .app-description {
    max-width: 340px;
    margin: 1rem 0 0;
    color: #52605a;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .open-app {
    margin-top: 2rem;
    color: #155e4a;
    font-size: 0.86rem;
    font-weight: 700;
  }

  /* =========================
     Footer
     ========================= */

  .site-footer {
    border-top: 1px solid #dce3de;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    color: #74807a;
    font-size: 0.84rem;
  }

  /* =========================
     Responsive
     ========================= */

  @media (max-width: 950px) {
    .apps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .container {
      width: calc(100% - 2rem);
    }

    .header-inner {
      min-height: 68px;
    }

    nav {
      gap: 0.8rem;
    }

    nav a {
      font-size: 0.8rem;
    }

    .brand-name {
      display: none;
    }

    .apps-hero {
      padding: 5.5rem 0 5rem;
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 5.5rem);
    }

    .intro {
      margin-top: 1.8rem;
      font-size: 1rem;
    }

    .apps-collection {
      padding: 3rem 0 5rem;
    }

    .collection-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .apps-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 1rem;
    }

    .app-card {
      min-height: 280px;
      padding: 1.5rem;
    }

    .app-card-content {
      padding-top: 3rem;
    }

    .app-card h2 {
      font-size: 1.35rem;
    }

    .app-description {
      font-size: 0.92rem;
    }
  }
</style>